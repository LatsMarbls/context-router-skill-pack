// ─────────────────────────────────────────────────────────────────────────────
// PRAXXYS Skill Pack — config
//
// This file merges into your existing context-routing.jsonc.
// Arrays append. Objects merge recursively. Scalars overwrite.
//
// Skill triggers are defined in each skill's frontmatter — no need
// to duplicate them here. The scanner discovers them automatically.
//
// Install: npx ocr-pack install [--project <path>]
// ─────────────────────────────────────────────────────────────────────────────

{
  // ── Skill locations ────────────────────────────────────────────────────────
  // Scanner auto-discovers all triggers/priorities/groups from frontmatter.
  "skillLocations": [
    "{project}/.opencode/skills/PRAXXYS/{name}/SKILL.md",
    "{user}/skills/PRAXXYS/{name}/SKILL.md"
  ],

  // ── Evaluate fresh each turn ───────────────────────────────────────────────
  // When false, only skills triggered by the current message/agent/file
  // are injected. Previous-turn skills are not accumulated.
  "accumulateSkills": false
}