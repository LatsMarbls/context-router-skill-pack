// ─────────────────────────────────────────────────────────────────────────────
// PRAXXYS Skill Pack — config
//
// This file merges into your existing context-routing.jsonc.
// Arrays append. Objects merge recursively. Scalars overwrite.
//
// Triggers, priority, and group membership are all declared in each
// skill's frontmatter — the scanner auto-discovers them. No need to
// duplicate trigger/group definitions in this file.
//
// Install: npx ocr-pack install [--project <path>]
// ─────────────────────────────────────────────────────────────────────────────

{
  // ── Skill locations ────────────────────────────────────────────────────────
  // Scanner auto-discovers all triggers/priorities/groups from frontmatter.
  "skillLocations": [
    "{project}/.opencode/skills/PRAXXYS/{name}/SKILL.md",
    "{user}/skills/PRAXXYS/{name}/SKILL.md"
  ],

  // ── Evaluate fresh each turn ───────────────────────────────────────────────
  // SCEUDRIX meta-triggers below expand into curated skill sets via
  // frontmatter `groups:` membership — see each skill's SKILL.md.
  "accumulateSkills": false,

  // ── SCEUDRIX meta-triggers ─────────────────────────────────────────────────
  // S=Show, C=Create, E=Edit, U=Update, D=Delete, R=Restore, I=Import, X=Export
  //
  // When the user types one of these keywords, expandGroups() loads every
  // skill whose frontmatter includes that group name in `groups: [...]`.
  //
  // Logic:
  //   Show appears when no Edit/Update → view page instead of edit page
  //   No Update → no Create → created through API/seeder, not form
  "contentTriggers": {
    "scrudrix": ["scrudrix"],
    "crudrix":  ["crudrix"],
    "sdrix":    ["sdrix"],
    "six":      ["six"],
    "sx":       ["sx"]
  }
}
