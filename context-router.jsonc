// ─────────────────────────────────────────────────────────────────────────────
// PRX Skill Pack — config
//
// This file merges into your existing context-routing.jsonc.
// Arrays overwrite. Objects merge recursively. Scalars overwrite.
//
// All triggers, priorities, and groups are declared in each skill's RULES.md
// frontmatter — the scanner discovers them automatically. There is no
// config-level trigger/group table anymore; the `contentTriggers` / `groups`
// blocks were removed with the old 4-dimension config model.
//
// Install: npx ocr-pack install [--project <path>]
// ─────────────────────────────────────────────────────────────────────────────

{
  // ── Skill locations ────────────────────────────────────────────────────────
  // Scanner auto-discovers triggers/priorities/groups from RULES.md frontmatter.
  "skillLocations": [
    "{project}/.opencode/rules/prx/{name}/RULES.md",
    "{user}/rules/prx/{name}/RULES.md"
  ],

  // ── Evaluate fresh each turn ───────────────────────────────────────────────
  "accumulateSkills": false,

  // ── File trigger precedence ────────────────────────────────────────────────
  // When a referenced file matches BOTH an extension trigger and a path pattern,
  // which wins. "path" lets the folder-path match suppress .ext; "extension"
  // lets the .ext trigger win over the folder-path match.
  // Primary agent and subagents are tuned independently.
  "precedencePrimary":  "path",
  "precedenceSubagent": "extension"
}
